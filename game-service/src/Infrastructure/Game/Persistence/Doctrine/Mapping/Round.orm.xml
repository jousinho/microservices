<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Game\Entity\Round" table="rounds">

        <id name="id" type="string" length="36" />

        <field name="sessionId"   type="string"             column="session_id"   length="36" />
        <field name="roundNumber" type="integer"            column="round_number" />
        <field name="noteId"      type="string"             column="note_id"      nullable="true" length="50" />
        <field name="correctNote" type="string"             column="correct_note" nullable="true" length="10" />
        <field name="startedAt"   type="datetime_immutable" column="started_at" />
        <field name="endedAt"     type="datetime_immutable" column="ended_at"     nullable="true" />

    </entity>

</doctrine-mapping>
