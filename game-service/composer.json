{
    "name": "guess-the-note/game-service",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "7.*",
        "symfony/dotenv": "7.*",
        "symfony/console": "7.*",
        "symfony/runtime": "7.*",
        "symfony/yaml": "7.*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/test-pack": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.*"
        }
    }
}
